  "grammars": [
    {
      "pattern": "～てください",
      "meaning": "Hãy làm gì đó...",
      "structure": "Động từ thể て + ください",
      "usageNote": "Dùng để đưa ra yêu cầu hoặc đề nghị lịch sự.",
      "level": "N5"
    },
    {
      "pattern": "～から～まで",
      "meaning": "Từ... đến...",
      "structure": "Danh từ + から + Danh từ + まで",
      "usageNote": "Chỉ mốc giới hạn về thời gian hoặc không gian.",
      "level": "N5"
    },
    {
      "pattern": "～なければならない",
      "meaning": "Phải làm gì đó...",
      "structure": "Động từ thể ない (bỏ い) + ければならない",
      "usageNote": "Biểu thị nghĩa vụ hoặc sự bắt buộc phải thực hiện hành động.",
      "level": "N4"
    },
    {
      "pattern": "～ことができる",
      "meaning": "Có thể làm gì đó...",
      "structure": "Động từ thể từ điển (V-ru) + ことができる",
      "usageNote": "Chỉ khả năng hoặc năng lực có thể thực hiện được.",
      "level": "N4"
    },
    {
      "pattern": "～たい",
      "meaning": "Muốn làm gì đó...",
      "structure": "Động từ thể ます (bỏ ます) + たい",
      "usageNote": "Diễn tả nguyện vọng, mong muốn làm việc gì của người nói.",
      "level": "N5"
    },
    {
      "pattern": "～たことがある",
      "meaning": "Đã từng làm gì đó...",
      "structure": "Động từ thể た + ことがある",
      "usageNote": "Diễn tả kinh nghiệm đã từng trải qua trong quá khứ.",
      "level": "N4"
    },
    {
      "pattern": "～ながら",
      "meaning": "Vừa... vừa...",
      "structure": "Động từ thể ます (bỏ ます) + ながら",
      "usageNote": "Diễn tả hai hành động được thực hiện đồng thời bởi một chủ thể.",
      "level": "N4"
    },
    {
      "pattern": "～ば",
      "meaning": "Nếu... thì...",
      "structure": "Động từ chia sang thể điều kiện (thể ば)",
      "usageNote": "Diễn tả giả định hoặc điều kiện giả định.",
      "level": "N3"
    },
    {
      "pattern": "～ようにする",
      "meaning": "Cố gắng làm/không làm gì đó...",
      "structure": "Động từ thể từ điển/thể ない + ようにする",
      "usageNote": "Diễn tả sự nỗ lực, cố gắng tạo thói quen hoặc hành động.",
      "level": "N3"
    },
    {
      "pattern": "～わけがない",
      "meaning": "Không lý nào/Lẽ nào lại...",
      "structure": "Thể thông thường + わけがない",
      "usageNote": "Biểu thị sự phủ định mạnh mẽ dựa trên lý do xác thực.",
      "level": "N2"
    }
  ]
}
